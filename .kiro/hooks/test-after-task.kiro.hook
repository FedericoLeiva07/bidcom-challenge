{
  "enabled": true,
  "name": "Run Tests After Task",
  "description": "Ejecuta los tests con Vitest después de completar cada tarea de implementación para asegurar que nada se rompió",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "npx vitest run --reporter=verbose 2>&1 | tail -50"
  }
}